# Bloquea el acceso directo a los datos. Solo api.php (que está fuera de
# esta carpeta) puede leerlos con readfile(). En Apache 2.4:
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
# Compatibilidad con Apache 2.2:
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
